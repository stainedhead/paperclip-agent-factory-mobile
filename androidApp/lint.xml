<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- Version currency is Dependabot's job (the catalog is the single place versions live); lint reads the
         catalog and would fail the build every time any library publishes a release. -->
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="GradleDependency" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <!-- androidx.lifecycle 2.11 ships a lint.jar that references newer lint APIs than AGP 9.5's lint; lint skips that
         jar's checks and reports the library, which is not something this project can fix. Revisit on an AGP bump. -->
    <issue id="ObsoleteLintCustomCheck" severity="ignore" />
</lint>
