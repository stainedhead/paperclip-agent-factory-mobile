<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Paperclip</string>

    <!-- The sentences the system authentication prompt shows (the device owner: fingerprint, face or screen lock). -->
    <string name="biometric_unlock_reason">Unlock Paperclip</string>
    <string name="biometric_confirm_reason">Confirm this action</string>
    <string name="biometric_write_reason">Protect the key for this factory</string>

    <!-- Shared labels. -->
    <string name="common_loading">Loading…</string>
    <string name="common_updated_ago">Updated %1$s ago</string>

    <string name="common_retry">Try again</string>
    <string name="common_sign_in_again">Sign in again</string>
    <string name="common_dismiss">Dismiss</string>
    <string name="common_offline">You\'re offline. Showing what was last loaded.</string>

    <!-- ErrorKey: one message per key (PRD FR-097). -->
    <string name="error_unreachable">Can\'t reach the factory. Check your connection or VPN.</string>
    <string name="error_certificate_invalid">The factory\'s security certificate could not be verified.</string>
    <string name="error_timeout">The factory took too long to answer.</string>
    <string name="error_signed_out">You\'re signed out of this factory. Sign in again to continue.</string>
    <string name="error_no_permission">Your role doesn\'t allow this.</string>
    <string name="error_not_found">That item no longer exists.</string>
    <string name="error_conflict">Someone else changed this first. Refresh to see the latest.</string>
    <string name="error_rejected">The factory rejected the request.</string>
    <string name="error_server_error">The factory had a problem. Try again in a moment.</string>
    <string name="error_rate_limited">Too many requests. Wait a moment and try again.</string>
    <string name="error_malformed">The factory sent something this app can\'t read.</string>
    <string name="error_invalid_key">That doesn\'t look like a board key. Nothing was sent.</string>
    <string name="error_storage_failed">This phone\'s secure storage refused to keep the key.</string>
    <string name="error_auth_declined">Paperclip could not read this phone\'s key: the fingerprint, face or screen lock was declined, or the phone is locked. Nothing was sent. Try again.</string>
    <string name="error_key_invalidated">This phone\'s key for the factory is no longer valid (for example after a fingerprint change). Pair this phone again.</string>
    <string name="error_current_key_unknown">This phone doesn\'t know which key is its own, so it won\'t revoke keys.</string>

    <!-- ActionsDisabledReason: why the buttons beside it are off. -->
    <string name="disabled_offline">You\'re offline. Actions are unavailable.</string>
    <string name="disabled_viewer_role">Your role is Viewer, so you can look but not change anything.</string>
    <string name="disabled_owner_role">Only an owner can do this.</string>

    <!-- AddressIssue. -->
    <string name="address_missing_scheme">Start the address with https://</string>
    <string name="address_must_use_https">Use a secure https:// address</string>
    <string name="address_missing_host">Add the server name after https://</string>
    <string name="address_invalid_host">The server name has characters that are not allowed</string>
    <string name="address_invalid_port">The port must be a number from 1 to 65535</string>
    <string name="address_invalid_path">The path after the server name has characters that are not allowed</string>
    <string name="address_remove_credentials">Remove the user name and password from the address</string>
    <string name="address_remove_query_or_fragment">Remove everything after the server address</string>

    <!-- DeviceAuthIssue: why the device owner was not confirmed. -->
    <string name="device_auth_cancelled">Authentication was cancelled. Nothing was changed.</string>
    <string name="device_auth_failed">The fingerprint, face or screen lock didn\'t recognise you. Nothing was changed.</string>
    <string name="device_auth_locked_out">Biometric sign-in is locked. Use your screen lock, then try again.</string>
    <string name="device_auth_unavailable">A fingerprint, face or screen lock isn\'t set up on this phone.</string>

    <!-- StartupNotice. -->
    <string name="startup_live_graph_unavailable">Paperclip could not open its data on this phone right now. Nothing was changed or deleted. Try again in a moment.</string>

    <!-- SeverityUi (shown in capitals; the word carries the meaning, the colour only reinforces it). -->
    <string name="severity_critical">Critical</string>
    <string name="severity_high">High</string>
    <string name="severity_medium">Medium</string>
    <string name="severity_low">Low</string>

