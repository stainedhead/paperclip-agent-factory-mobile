<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        The two on-demand benchmark build types only (benchmark and nonMinified; never release, never distributed, ADR-135).
        Macrobenchmark measures a profileable app, not a debuggable one, and installs the baseline profile by broadcasting
        to androidx.profileinstaller's receiver. The receiver is exported by the library but guarded by the DUMP
        permission, which only the shell holds, so no other app can reach it; AndroidManifestRulesTest allows exactly
        that and nothing else. The main manifest removes the receiver for the shipping builds; this overrides the removal.
    -->
    <application>
        <profileable
            android:shell="true"
            tools:targetApi="q" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:node="replace">
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
